rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidImageUpload() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /profile_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && (request.resource == null || (
          request.resource.size > 0
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg'
        ));
    }

    match /product-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isValidImageUpload());
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isValidImageUpload());
    }

    match /category-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isValidImageUpload());
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isValidImageUpload());
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isValidImageUpload());
    }

    match /in-app-notifications/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isValidImageUpload());
    }
  }
}