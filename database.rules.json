{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && newData.child('role').val() === 'user' && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('role').exists() && newData.child('role').val() === data.child('role').val() && newData.child('uid').val() === data.child('uid').val()))) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['uid', 'role'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'user' || newData.val() === 'admin')"
        },
        "name": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "photoURL": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren()"
        }
      }
    },
    "active_callbacks": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$userId": {
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
          ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED')"
        }
      }
    },
    "support_callbacks": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$recordKey": {
        ".write": false,
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
          ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED')"
        },
        "$nestedKey": {
          ".write": false,
          "status": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
            ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED')"
          },
          "$deepKey": {
            ".write": false,
            "status": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
              ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED')"
            },
            "$leafKey": {
              ".write": false,
              "status": {
                ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
                ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED')"
              }
            }
          }
        }
      }
    },
    "categories": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "products": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "orders": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$recordKey": {
        "paymentStatus": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.val() === 'COMPLETED' && data.val() === 'PENDING'"
        },
        "orderStatus": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && ((data.val() === 'PLACED' && (newData.val() === 'CONFIRMED' || newData.val() === 'CANCELLED')) || (data.val() === 'CONFIRMED' && (newData.val() === 'PROCESSING' || newData.val() === 'CANCELLED')) || (data.val() === 'PROCESSING' && (newData.val() === 'READY_TO_SHIP' || newData.val() === 'CANCELLED')) || (data.val() === 'READY_TO_SHIP' && newData.val() === 'OUT_FOR_DELIVERY') || (data.val() === 'OUT_FOR_DELIVERY' && newData.val() === 'DELIVERED'))"
        },
        "confirmedAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CONFIRMED') || (data.exists() && newData.val() === data.val()))"
        },
        "processingAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'PROCESSING') || (data.exists() && newData.val() === data.val()))"
        },
        "readyToShipAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'READY_TO_SHIP') || (data.exists() && newData.val() === data.val()))"
        },
        "outForDeliveryAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'OUT_FOR_DELIVERY') || (data.exists() && newData.val() === data.val()))"
        },
        "deliveredAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'DELIVERED') || (data.exists() && newData.val() === data.val()))"
        },
        "cancelledAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CANCELLED') || (data.exists() && newData.val() === data.val()))"
        },
        "$orderId": {
          "paymentStatus": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.val() === 'COMPLETED' && data.val() === 'PENDING'"
          },
          "orderStatus": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isString() && ((data.val() === 'PLACED' && (newData.val() === 'CONFIRMED' || newData.val() === 'CANCELLED')) || (data.val() === 'CONFIRMED' && (newData.val() === 'PROCESSING' || newData.val() === 'CANCELLED')) || (data.val() === 'PROCESSING' && (newData.val() === 'READY_TO_SHIP' || newData.val() === 'CANCELLED')) || (data.val() === 'READY_TO_SHIP' && newData.val() === 'OUT_FOR_DELIVERY') || (data.val() === 'OUT_FOR_DELIVERY' && newData.val() === 'DELIVERED'))"
          },
          "confirmedAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CONFIRMED') || (data.exists() && newData.val() === data.val()))"
          },
          "processingAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'PROCESSING') || (data.exists() && newData.val() === data.val()))"
          },
          "readyToShipAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'READY_TO_SHIP') || (data.exists() && newData.val() === data.val()))"
          },
          "outForDeliveryAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'OUT_FOR_DELIVERY') || (data.exists() && newData.val() === data.val()))"
          },
          "deliveredAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'DELIVERED') || (data.exists() && newData.val() === data.val()))"
          },
          "cancelledAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CANCELLED') || (data.exists() && newData.val() === data.val()))"
          }
        }
      }
    }
  }
}
