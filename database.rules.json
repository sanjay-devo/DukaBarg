{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && (newData.child('role').val() === 'user' || newData.child('role').val() === 'customer') && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('role').exists() && newData.child('role').val() === data.child('role').val() && newData.child('uid').val() === data.child('uid').val()))) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['uid', 'role'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'user' || newData.val() === 'customer' || newData.val() === 'admin')"
        },
        "name": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "photoURL": {
          ".validate": "newData.isString()"
        },
        "fcmTokens": {
          "$tokenId": {
            ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('role').val() === 'customer'",
            ".validate": "!newData.exists() || (newData.hasChildren(['token', 'platform', 'updatedAt']) && newData.child('token').isString() && newData.child('token').val().length >= 20 && newData.child('token').val().length <= 4096 && newData.child('platform').isString() && (newData.child('platform').val() === 'android' || newData.child('platform').val() === 'ios' || newData.child('platform').val() === 'web') && newData.child('updatedAt').isNumber())",
            "token": {
              ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 4096"
            },
            "platform": {
              ".validate": "newData.isString() && (newData.val() === 'android' || newData.val() === 'ios' || newData.val() === 'web')"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean() || newData.hasChildren()"
        }
      }
    },
    "pushNotifications": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },
    "pushNotificationOpens": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },
    "active_callbacks": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$userId": {
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
          ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED' || newData.val() === 'CANCELLED')"
        }
      }
    },
    "support_callbacks": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$recordKey": {
        ".write": false,
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
          ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED' || newData.val() === 'CANCELLED')"
        },
        "$nestedKey": {
          ".write": false,
          "status": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
            ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED' || newData.val() === 'CANCELLED')"
          },
          "$deepKey": {
            ".write": false,
            "status": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
              ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED' || newData.val() === 'CANCELLED')"
            },
            "$leafKey": {
              ".write": false,
              "status": {
                ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && data.parent().exists()",
                ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'CONNECTING' || newData.val() === 'CONNECTED' || newData.val() === 'ENDED' || newData.val() === 'EXPIRED' || newData.val() === 'CANCELLED')"
              }
            }
          }
        }
      }
    },
    "categories": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "products": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "orders": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$recordKey": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $recordKey || data.child('userId').val() === auth.uid || data.child('uid').val() === auth.uid || data.child('customerUid').val() === auth.uid)",
        "paymentStatus": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.val() === 'COMPLETED' && data.val() === 'PENDING'"
        },
        "orderStatus": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && ((data.val() === 'PLACED' && (newData.val() === 'CONFIRMED' || newData.val() === 'CANCELLED')) || (data.val() === 'CONFIRMED' && (newData.val() === 'PROCESSING' || newData.val() === 'CANCELLED')) || (data.val() === 'PROCESSING' && (newData.val() === 'READY_TO_SHIP' || newData.val() === 'CANCELLED')) || (data.val() === 'READY_TO_SHIP' && (newData.val() === 'OUT_FOR_DELIVERY' || newData.val() === 'CANCELLED')) || (data.val() === 'OUT_FOR_DELIVERY' && (newData.val() === 'DELIVERED' || newData.val() === 'CANCELLED')))"
        },
        "confirmedAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CONFIRMED') || (data.exists() && newData.val() === data.val()))"
        },
        "processingAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'PROCESSING') || (data.exists() && newData.val() === data.val()))"
        },
        "readyToShipAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'READY_TO_SHIP') || (data.exists() && newData.val() === data.val()))"
        },
        "outForDeliveryAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'OUT_FOR_DELIVERY') || (data.exists() && newData.val() === data.val()))"
        },
        "deliveredAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'DELIVERED') || (data.exists() && newData.val() === data.val()))"
        },
        "cancelledAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CANCELLED') || (data.exists() && newData.val() === data.val()))"
        },
        "cancelledFromStatus": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CANCELLED' && (newData.val() === 'PLACED' || newData.val() === 'CONFIRMED' || newData.val() === 'PROCESSING' || newData.val() === 'READY_TO_SHIP' || newData.val() === 'OUT_FOR_DELIVERY')) || (data.exists() && newData.val() === data.val()))"
        },
        "cancellationReason": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && newData.val().length <= 500 && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CANCELLED') || (data.exists() && newData.val() === data.val()))"
        },
        "$orderId": {
          "paymentStatus": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.val() === 'COMPLETED' && data.val() === 'PENDING'"
          },
          "orderStatus": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isString() && ((data.val() === 'PLACED' && (newData.val() === 'CONFIRMED' || newData.val() === 'CANCELLED')) || (data.val() === 'CONFIRMED' && (newData.val() === 'PROCESSING' || newData.val() === 'CANCELLED')) || (data.val() === 'PROCESSING' && (newData.val() === 'READY_TO_SHIP' || newData.val() === 'CANCELLED')) || (data.val() === 'READY_TO_SHIP' && (newData.val() === 'OUT_FOR_DELIVERY' || newData.val() === 'CANCELLED')) || (data.val() === 'OUT_FOR_DELIVERY' && (newData.val() === 'DELIVERED' || newData.val() === 'CANCELLED')))"
          },
          "confirmedAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CONFIRMED') || (data.exists() && newData.val() === data.val()))"
          },
          "processingAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'PROCESSING') || (data.exists() && newData.val() === data.val()))"
          },
          "readyToShipAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'READY_TO_SHIP') || (data.exists() && newData.val() === data.val()))"
          },
          "outForDeliveryAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'OUT_FOR_DELIVERY') || (data.exists() && newData.val() === data.val()))"
          },
          "deliveredAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'DELIVERED') || (data.exists() && newData.val() === data.val()))"
          },
          "cancelledAt": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CANCELLED') || (data.exists() && newData.val() === data.val()))"
          },
          "cancelledFromStatus": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isString() && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CANCELLED' && (newData.val() === 'PLACED' || newData.val() === 'CONFIRMED' || newData.val() === 'PROCESSING' || newData.val() === 'READY_TO_SHIP' || newData.val() === 'OUT_FOR_DELIVERY')) || (data.exists() && newData.val() === data.val()))"
          },
          "cancellationReason": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
            ".validate": "newData.isString() && newData.val().length <= 500 && ((!data.exists() && newData.parent().child('orderStatus').val() === 'CANCELLED') || (data.exists() && newData.val() === data.val()))"
          }
        }
      }
    },
    "settings": {
      "charges": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "payment": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}
